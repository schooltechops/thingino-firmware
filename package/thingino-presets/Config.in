config BR2_PACKAGE_THINGINO_PRESETS
	bool "Settings presets"
	default y if BR2_PACKAGE_THINGINO_WEBUI && BR2_PACKAGE_THINGINO_RAPTOR
	depends on BR2_PACKAGE_THINGINO_RAPTOR
	help
	  Named sets of streamer (raptor.conf), ONVIF (onvif.json) and system
	  (thingino.json) settings that are applied in one step, shown as a
	  diff first and undoable. Built-in presets: UniFi Protect, Frigate /
	  go2rtc, Weak Wi-Fi and Thingino defaults; users can save their own.

	  CLI: thingino-preset list|show|diff|apply|undo|save|status
	  Web UI: Settings > Presets

config BR2_PACKAGE_THINGINO_PRESETS_UNIFI
	bool "UniFi Protect mode"
	default y
	depends on BR2_PACKAGE_THINGINO_PRESETS
	depends on BR2_PACKAGE_THINGINO_ONVIF
	help
	  Settings > UniFi Protect: one switch that applies (or undoes) the
	  unifi-protect preset, readiness checks for native ONVIF adoption
	  (event service, single motion topic, AAC audio, matching sensor and
	  stream frame rates, shared ONVIF/RTSP login, clock) and the values
	  to enter in Protect.
