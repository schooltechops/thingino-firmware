From 9adb2b7dbc2cad3dc44b685fc9dc88782ad9b02e Mon Sep 17 00:00:00 2001
From: Rob Pelletier <ropelletier@rsu87.org>
Date: Thu, 26 Nov 2026 11:21:12 -0500
Subject: [PATCH 1/2] rsd: make the per-client send queue depth configurable

The per-client send queue is a fixed 32 entries, about 0.4 s of a
25 fps stream plus audio. On a busy 2.4 GHz link a client stalls for
1-3 s at a time; each stall overflows the queue, which drops all queued
video and waits for the next IDR -- a visible freeze plus an extra
large frame on the link that just stalled.

Add [rtsp] sendq_slots (default 32, clamped to 8..1024). The ring and
the scratch buffer used while dropping video are allocated per client
at that size (the scratch replaces a stack array of queue size).
rsd_sendq_init() keeps its meaning; rsd_sendq_init_slots() sizes it.
The queue only fills while a client is stalled, so a deeper queue costs
memory during a stall, not steady-state latency.

Measured on a Wyze Cam v3 (T31X) on a congested channel: 256 slots
absorbed stalls that overflowed the 32-slot queue several times an hour.

Tests: depth honoured and ring wraps past 32, clamping, default depth,
arrays freed on destroy. Full suite passes under ASan/UBSan.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 config/raptor.conf    |  1 +
 rsd/rsd.h             |  1 +
 rsd/rsd_main.c        |  5 ++--
 rsd/rsd_ring_reader.c |  2 +-
 rsd/rsd_sendq.c       | 58 ++++++++++++++++++++++++++++------------
 rsd/rsd_sendq.h       | 20 +++++++++++---
 rsd/rsd_server.c      |  2 +-
 tests/test_sendq.c    | 61 ++++++++++++++++++++++++++++++++++++++++++-
 8 files changed, 125 insertions(+), 25 deletions(-)

diff --git a/config/raptor.conf b/config/raptor.conf
index cca736f..c6bd63a 100644
--- a/config/raptor.conf
+++ b/config/raptor.conf
@@ -244,6 +244,7 @@ video_device = /dev/video0
 # session_info =              # SDP session description (i=)
 # session_timeout = 60        # RTSP session timeout in seconds (min 10)
 # tcp_sndbuf = 65536          # requested TCP send-buffer bytes; Linux doubles/caps it
+# sendq_slots = 32            # per-client queue (frames+audio chunks, 8-1024); raise on weak Wi-Fi so stalls do not drop video to the next IDR
 #                             # (lower bounds stale data; blocking writes split large IDRs)
 # backchannel = false         # two-way audio (ONVIF Profile T). Offers PCMU,
 #                             # PCMA, opus, AAC and L16; the client picks by
diff --git a/rsd/rsd.h b/rsd/rsd.h
index 73a9a46..32e4f6a 100644
--- a/rsd/rsd.h
+++ b/rsd/rsd.h
@@ -235,6 +235,7 @@ typedef struct rsd_server {
 	int max_clients;     /* runtime limit (≤ RSD_MAX_CLIENTS) */
 	int session_timeout; /* RTSP session timeout in seconds */
 	int tcp_sndbuf;	     /* TCP send buffer size (bytes) */
+	int sendq_slots; /* per-client send queue depth ([rtsp] sendq_slots) */
 	bool rtcp_sr;	     /* send RTCP Sender Reports (default true) */
 	bool jpeg_enabled;   /* expose JPEG streams (default false) */
 	bool sei_timecode;   /* per-frame ST 0604 UTC SEI (default true) */
diff --git a/rsd/rsd_main.c b/rsd/rsd_main.c
index 393efb6..8a48af2 100644
--- a/rsd/rsd_main.c
+++ b/rsd/rsd_main.c
@@ -85,6 +85,7 @@ int main(int argc, char **argv)
 	if (srv.session_timeout < 10)
 		srv.session_timeout = 10;
 	srv.tcp_sndbuf = rss_config_get_int(dctx.cfg, "rtsp", "tcp_sndbuf", 64 * 1024);
+	srv.sendq_slots = rss_config_get_int(dctx.cfg, "rtsp", "sendq_slots", RSD_SENDQ_SLOTS);
 	srv.rtcp_sr = rss_config_get_bool(dctx.cfg, "rtsp", "rtcp_sr", true);
 	srv.idr_on_join = rss_config_get_bool(dctx.cfg, "rtsp", "idr_on_join", true);
 	srv.jpeg_enabled = rss_config_get_bool(dctx.cfg, "rtsp", "jpeg", false);
@@ -185,8 +186,8 @@ int main(int argc, char **argv)
 #endif
 
 	RSS_INFO("RTSP listening on port %d%s", srv.port, tls_enabled ? " (TLS)" : "");
-	RSS_DEBUG("  max_clients=%d session_timeout=%d tcp_sndbuf=%d rtcp_sr=%d", srv.max_clients,
-		  srv.session_timeout, srv.tcp_sndbuf, srv.rtcp_sr);
+	RSS_DEBUG("  max_clients=%d session_timeout=%d tcp_sndbuf=%d sendq_slots=%d rtcp_sr=%d", srv.max_clients,
+		  srv.session_timeout, srv.tcp_sndbuf, srv.sendq_slots, srv.rtcp_sr);
 
 	ret = rsd_server_init(&srv);
 	if (ret != 0) {
diff --git a/rsd/rsd_ring_reader.c b/rsd/rsd_ring_reader.c
index 2a1c8b3..ca1f8aa 100644
--- a/rsd/rsd_ring_reader.c
+++ b/rsd/rsd_ring_reader.c
@@ -265,7 +265,7 @@ void *rsd_client_send_thread(void *arg)
 
 		rsd_sendq_entry_t entry = q->entries[q->tail];
 		q->entries[q->tail].data = NULL;
-		q->tail = (q->tail + 1) % RSD_SENDQ_SLOTS;
+		q->tail = (q->tail + 1) % q->slots;
 		q->count--;
 		pthread_mutex_unlock(&q->lock);
 
diff --git a/rsd/rsd_sendq.c b/rsd/rsd_sendq.c
index af784f1..4971cdf 100644
--- a/rsd/rsd_sendq.c
+++ b/rsd/rsd_sendq.c
@@ -14,16 +14,39 @@
 
 #include "rsd_sendq.h"
 
-int rsd_sendq_init(rsd_sendq_t *q)
+int rsd_sendq_init_slots(rsd_sendq_t *q, int slots)
 {
 	memset(q, 0, sizeof(*q));
-	if (pthread_mutex_init(&q->lock, NULL) != 0)
+	if (slots < RSD_SENDQ_MIN_SLOTS)
+		slots = RSD_SENDQ_MIN_SLOTS;
+	if (slots > RSD_SENDQ_MAX_SLOTS)
+		slots = RSD_SENDQ_MAX_SLOTS;
+	q->entries = calloc((size_t)slots, sizeof(*q->entries));
+	q->scratch = calloc((size_t)slots, sizeof(*q->scratch));
+	if (!q->entries || !q->scratch) {
+		free(q->entries);
+		free(q->scratch);
+		q->entries = q->scratch = NULL;
 		return -1;
+	}
+	q->slots = slots;
+	if (pthread_mutex_init(&q->lock, NULL) != 0)
+		goto fail;
 	if (pthread_cond_init(&q->cond, NULL) != 0) {
 		pthread_mutex_destroy(&q->lock);
-		return -1;
+		goto fail;
 	}
 	return 0;
+fail:
+	free(q->entries);
+	free(q->scratch);
+	q->entries = q->scratch = NULL;
+	return -1;
+}
+
+int rsd_sendq_init(rsd_sendq_t *q)
+{
+	return rsd_sendq_init_slots(q, RSD_SENDQ_SLOTS);
 }
 
 void rsd_sendq_release_entry(rsd_sendq_entry_t *e)
@@ -36,11 +59,14 @@ void rsd_sendq_destroy(rsd_sendq_t *q)
 {
 	while (q->count > 0) {
 		rsd_sendq_release_entry(&q->entries[q->tail]);
-		q->tail = (q->tail + 1) % RSD_SENDQ_SLOTS;
+		q->tail = (q->tail + 1) % q->slots;
 		q->count--;
 	}
 	pthread_cond_destroy(&q->cond);
 	pthread_mutex_destroy(&q->lock);
+	free(q->entries);
+	free(q->scratch);
+	q->entries = q->scratch = NULL;
 }
 
 /*
@@ -51,13 +77,13 @@ void rsd_sendq_destroy(rsd_sendq_t *q)
  */
 static void sendq_drop_video_locked(rsd_sendq_t *q)
 {
-	rsd_sendq_entry_t audio[RSD_SENDQ_SLOTS];
+	rsd_sendq_entry_t *audio = q->scratch; /* sized like the ring: no stack array */
 	int audio_count = 0;
 
 	while (q->count > 0) {
 		rsd_sendq_entry_t entry = q->entries[q->tail];
 		q->entries[q->tail].data = NULL;
-		q->tail = (q->tail + 1) % RSD_SENDQ_SLOTS;
+		q->tail = (q->tail + 1) % q->slots;
 		q->count--;
 
 		if (entry.type == RSD_FRAME_AUDIO) {
@@ -72,7 +98,7 @@ static void sendq_drop_video_locked(rsd_sendq_t *q)
 	q->tail = 0;
 	for (int i = 0; i < audio_count; i++) {
 		q->entries[q->head] = audio[i];
-		q->head = (q->head + 1) % RSD_SENDQ_SLOTS;
+		q->head = (q->head + 1) % q->slots;
 		q->count++;
 	}
 }
@@ -89,7 +115,7 @@ static void sendq_drop_video_locked(rsd_sendq_t *q)
 bool rsd_sendq_take_audio_locked(rsd_sendq_t *q, rsd_sendq_entry_t *out)
 {
 	for (int i = 0; i < q->count; i++) {
-		int idx = (q->tail + i) % RSD_SENDQ_SLOTS;
+		int idx = (q->tail + i) % q->slots;
 		if (q->entries[idx].type != RSD_FRAME_AUDIO)
 			continue;
 
@@ -97,12 +123,12 @@ bool rsd_sendq_take_audio_locked(rsd_sendq_t *q, rsd_sendq_entry_t *out)
 		q->entries[idx].data = NULL;
 		/* Shift the entries behind it forward to fill the gap */
 		for (int j = i; j > 0; j--) {
-			int dst = (q->tail + j) % RSD_SENDQ_SLOTS;
-			int src = (q->tail + j - 1) % RSD_SENDQ_SLOTS;
+			int dst = (q->tail + j) % q->slots;
+			int src = (q->tail + j - 1) % q->slots;
 			q->entries[dst] = q->entries[src];
 		}
 		q->entries[q->tail].data = NULL;
-		q->tail = (q->tail + 1) % RSD_SENDQ_SLOTS;
+		q->tail = (q->tail + 1) % q->slots;
 		q->count--;
 		return true;
 	}
@@ -171,7 +197,7 @@ int rsd_sendq_push_video(rsd_sendq_t *q, const uint8_t *data, uint32_t len, uint
 		return -1;
 	}
 
-	if (q->count >= RSD_SENDQ_SLOTS) {
+	if (q->count >= q->slots) {
 		q->overflows++;
 		sendq_drop_video_locked(q);
 		q->drop_video++; /* incoming pre-keyframe frame */
@@ -188,7 +214,7 @@ int rsd_sendq_push_video(rsd_sendq_t *q, const uint8_t *data, uint32_t len, uint
 	slot->type = RSD_FRAME_VIDEO;
 	slot->codec = 0;
 
-	q->head = (q->head + 1) % RSD_SENDQ_SLOTS;
+	q->head = (q->head + 1) % q->slots;
 	q->count++;
 
 	pthread_cond_signal(&q->cond);
@@ -215,7 +241,7 @@ int rsd_sendq_push_audio(rsd_sendq_t *q, uint32_t codec, const uint8_t *data, ui
 	 * Overflow used to flush the whole queue. That is a defensible video
 	 * policy -- a decoder that has lost frames wants the next IDR, not the
 	 * frames in between -- and the wrong one for audio, where every chunk
-	 * is independently useful: it discards up to RSD_SENDQ_SLOTS entries,
+	 * is independently useful: it discards up to q->slots entries,
 	 * a noticeable hole in the sound, to make room for 20ms of it. Worse, it
 	 * takes the queued video with it.
 	 *
@@ -226,7 +252,7 @@ int rsd_sendq_push_audio(rsd_sendq_t *q, uint32_t codec, const uint8_t *data, ui
 	 * frame has nowhere to go; drop the incoming one rather than start
 	 * evicting video behind the send thread's back.
 	 */
-	if (q->count >= RSD_SENDQ_SLOTS) {
+	if (q->count >= q->slots) {
 		rsd_sendq_entry_t victim;
 
 		q->overflows++;
@@ -251,7 +277,7 @@ int rsd_sendq_push_audio(rsd_sendq_t *q, uint32_t codec, const uint8_t *data, ui
 	slot->codec = codec;
 	slot->zerocopy = false; /* unused, kept for ABI compat */
 
-	q->head = (q->head + 1) % RSD_SENDQ_SLOTS;
+	q->head = (q->head + 1) % q->slots;
 	q->count++;
 
 	pthread_cond_signal(&q->cond);
diff --git a/rsd/rsd_sendq.h b/rsd/rsd_sendq.h
index 6304824..8b1ab11 100644
--- a/rsd/rsd_sendq.h
+++ b/rsd/rsd_sendq.h
@@ -18,7 +18,9 @@
  * waiting for any send thread to finish. The memcpy cost is small
  * next to the send-latency hit we'd otherwise take from a barrier
  * wait, especially on slow single-core SoCs. */
-#define RSD_SENDQ_SLOTS	  32
+#define RSD_SENDQ_SLOTS	  32   /* default depth ([rtsp] sendq_slots) */
+#define RSD_SENDQ_MIN_SLOTS 8
+#define RSD_SENDQ_MAX_SLOTS 1024
 #define RSD_FRAME_VIDEO	  0
 #define RSD_FRAME_AUDIO	  1
 #define RSD_SENDQ_OK	  0
@@ -37,7 +39,9 @@ typedef struct {
 } rsd_sendq_entry_t;
 
 typedef struct {
-	rsd_sendq_entry_t entries[RSD_SENDQ_SLOTS];
+	rsd_sendq_entry_t *entries; /* ring of `slots` entries */
+	rsd_sendq_entry_t *scratch; /* `slots` entries, used while dropping video */
+	int slots;
 	int head;
 	int tail;
 	int count;
@@ -48,19 +52,27 @@ typedef struct {
 	 * Discard accounting. One queue carries both streams, audio pushes at
 	 * 50/s against video's 30/s, and a single video entry can hold the send
 	 * thread for the length of an IDR's worth of blocking writes -- so
-	 * RSD_SENDQ_SLOTS is about 400ms of a 25fps video plus AAC stream. This
+	 * the default RSD_SENDQ_SLOTS is about 400ms of a 25fps video plus AAC stream. This
 	 * absorbs ordinary Wi-Fi scheduling stalls without growing the queue far
 	 * enough to hide a genuinely slow client. Without these counters an
 	 * overflow is indistinguishable from a capture fault, which is exactly
 	 * the confusion that cost a round of board testing on the
 	 * audio dropouts.
+	 *
+	 * On a busy 2.4 GHz link a client can stall for 1-3 s; every overflow
+	 * then drops video to the next IDR (a visible freeze). [rtsp]
+	 * sendq_slots raises the depth for such links: the queue only fills
+	 * while the client is stalled, so a deeper queue costs memory, not
+	 * steady-state latency.
 	 */
 	uint32_t drop_audio; /* audio entries discarded to overflow */
 	uint32_t drop_video; /* video entries discarded to overflow */
 	uint32_t overflows;  /* times the queue was full on push */
 } rsd_sendq_t;
 
-int rsd_sendq_init(rsd_sendq_t *q);
+int rsd_sendq_init(rsd_sendq_t *q); /* RSD_SENDQ_SLOTS deep */
+/* slots is clamped to [RSD_SENDQ_MIN_SLOTS, RSD_SENDQ_MAX_SLOTS] */
+int rsd_sendq_init_slots(rsd_sendq_t *q, int slots);
 void rsd_sendq_destroy(rsd_sendq_t *q);
 void rsd_sendq_release_entry(rsd_sendq_entry_t *e);
 /* Caller holds q->lock. */
diff --git a/rsd/rsd_server.c b/rsd/rsd_server.c
index 5d6aed5..9c1293b 100644
--- a/rsd/rsd_server.c
+++ b/rsd/rsd_server.c
@@ -281,7 +281,7 @@ static void accept_client(rsd_server_t *srv)
 	/* Initialize send queue and thread before taking the lock —
 	 * readers block on clients_lock so keep the critical section short. */
 	pthread_mutex_init(&client->write_lock, NULL);
-	if (rsd_sendq_init(&client->sendq) != 0) {
+	if (rsd_sendq_init_slots(&client->sendq, srv->sendq_slots) != 0) {
 		pthread_mutex_destroy(&client->write_lock);
 		goto reject_client;
 	}
diff --git a/tests/test_sendq.c b/tests/test_sendq.c
index 324d8a2..2d428f3 100644
--- a/tests/test_sendq.c
+++ b/tests/test_sendq.c
@@ -33,7 +33,7 @@ static int snapshot(rsd_sendq_t *q, uint8_t *types, uint32_t *ts, int max)
 {
 	int n = 0;
 	for (int i = 0; i < q->count && n < max; i++) {
-		int idx = (q->tail + i) % RSD_SENDQ_SLOTS;
+		int idx = (q->tail + i) % q->slots;
 		types[n] = q->entries[idx].type;
 		ts[n] = q->entries[idx].rtp_ts;
 		n++;
@@ -271,6 +271,62 @@ TEST destroy_frees_pending_entries(void)
 	PASS();
 }
 
+/* [rtsp] sendq_slots: a deeper queue absorbs a longer client stall before
+ * the video-overflow policy kicks in; the policy itself is unchanged. */
+TEST configurable_depth_overflows_at_its_own_size(void)
+{
+	rsd_sendq_t q;
+	ASSERT_EQ(0, rsd_sendq_init_slots(&q, 64));
+	ASSERT_EQ(64, q.slots);
+
+	ASSERT_EQ(RSD_SENDQ_OK, push_a(&q, 1));
+	for (uint32_t i = 0; i < 63; i++)
+		ASSERT_EQ(RSD_SENDQ_OK, push_v(&q, 100 + i));
+	ASSERT_EQ(64, q.count);
+	ASSERT_EQ(0u, q.overflows);
+
+	/* the 65th entry overflows: video dropped, queued audio kept */
+	ASSERT_EQ(RSD_SENDQ_DROPPED, push_v(&q, 500));
+	ASSERT_EQ(1u, q.overflows);
+	ASSERT_EQ(1, q.count);
+	ASSERT_EQ(RSD_FRAME_AUDIO, q.entries[q.tail].type);
+	ASSERT_EQ(1u, q.entries[q.tail].rtp_ts);
+
+	/* the ring wraps correctly past the old fixed size */
+	for (uint32_t i = 0; i < 63; i++)
+		ASSERT_EQ(RSD_SENDQ_OK, push_v(&q, 600 + i));
+	uint8_t types[64];
+	uint32_t ts[64];
+	ASSERT_EQ(64, snapshot(&q, types, ts, 64));
+	ASSERT_EQ(662u, ts[63]);
+
+	rsd_sendq_destroy(&q);
+	PASS();
+}
+
+TEST depth_is_clamped(void)
+{
+	rsd_sendq_t q;
+	ASSERT_EQ(0, rsd_sendq_init_slots(&q, 2));
+	ASSERT_EQ(RSD_SENDQ_MIN_SLOTS, q.slots);
+	rsd_sendq_destroy(&q);
+	ASSERT_EQ(0, rsd_sendq_init_slots(&q, 1 << 20));
+	ASSERT_EQ(RSD_SENDQ_MAX_SLOTS, q.slots);
+	rsd_sendq_destroy(&q);
+	PASS();
+}
+
+TEST default_init_keeps_default_depth(void)
+{
+	rsd_sendq_t q;
+	ASSERT_EQ(0, rsd_sendq_init(&q));
+	ASSERT_EQ(RSD_SENDQ_SLOTS, q.slots);
+	rsd_sendq_destroy(&q);
+	ASSERT_EQ(NULL, q.entries);
+	ASSERT_EQ(NULL, q.scratch);
+	PASS();
+}
+
 SUITE(sendq_suite)
 {
 	RUN_TEST(push_pop_order_preserved);
@@ -282,4 +338,7 @@ SUITE(sendq_suite)
 	RUN_TEST(sei_spliced_before_first_vcl);
 	RUN_TEST(shutdown_rejects_pushes);
 	RUN_TEST(destroy_frees_pending_entries);
+	RUN_TEST(configurable_depth_overflows_at_its_own_size);
+	RUN_TEST(depth_is_clamped);
+	RUN_TEST(default_init_keeps_default_depth);
 }
